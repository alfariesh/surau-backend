{
 "uid": "surau-health",
 "title": "Surau Health",
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Request rate per route",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total[5m])) by (path)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{path}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "title": "Error rate (5xx %)",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.0001)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "5xx %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "p95 latency",
   "type": "timeseries",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Email queue",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "surau_email_queued",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "queued"
    },
    {
     "refId": "B",
     "expr": "surau_email_retrying",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "retrying"
    },
    {
     "refId": "C",
     "expr": "surau_email_failed",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "failed (dead letter)"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Oldest due email age",
   "type": "timeseries",
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 4,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "surau_email_oldest_due_seconds",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "oldest due"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Background loop — seconds since last success",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - surau_loop_last_success_timestamp_seconds",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{loop}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Disk free %",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "free %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Backup age (hours)",
   "type": "timeseries",
   "gridPos": {
    "x": 6,
    "y": 16,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(time() - surau_backup_last_success_timestamp) / 3600",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "daily dump"
    },
    {
     "refId": "B",
     "expr": "(time() - surau_pitr_check_last_success_timestamp) / 3600",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "pitr check"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Host memory available",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "mem available %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "title": "Host CPU busy %",
   "type": "timeseries",
   "gridPos": {
    "x": 18,
    "y": 16,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "cpu busy"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "title": "DB connections vs max (F1-G)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(pg_stat_activity_count)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "connections"
    },
    {
     "refId": "B",
     "expr": "pg_settings_max_connections",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "max_connections"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "title": "DB slow statements — top mean time (F1-G)",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 23,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(5, rate(pg_stat_statements_seconds_total[5m]) / clamp_min(rate(pg_stat_statements_calls_total[5m]), 1e-9))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{queryid}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "title": "DB relation sizes — top tables (F1-G)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "surau_db_relation_total_bytes",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{relation}} total"
    },
    {
     "refId": "B",
     "expr": "surau_db_relation_index_bytes",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{relation}} index"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "title": "DB autovacuum age & dead tuples (F1-G)",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 31,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(pg_stat_user_tables_last_autovacuum) ",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "seconds since last autovacuum"
    },
    {
     "refId": "B",
     "expr": "sum(pg_stat_user_tables_n_dead_tup)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "dead tuples (total)"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 15,
   "title": "DB cache hit ratio (F1-G)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])), 1)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "hit ratio"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 16,
   "title": "Streak reminders — accepted vs failed",
   "description": "Jumlah logical delivery pada rentang dashboard. accepted berarti OneSignal menerima request, bukan konfirmasi notifikasi tampil di perangkat.",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 47,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(max without(instance, job) (increase(surau_notification_deliveries_total{notification_type=\"streak_reminder\",status=\"accepted\"}[$__range]))) or vector(0)",
     "instant": true,
     "range": false,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "accepted"
    },
    {
     "refId": "B",
     "expr": "sum(max without(instance, job) (increase(surau_notification_deliveries_total{notification_type=\"streak_reminder\",status=\"failed\"}[$__range]))) or vector(0)",
     "instant": true,
     "range": false,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "failed"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "accepted"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "values": false,
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "orientation": "horizontal",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto"
   }
  },
  {
   "id": 17,
   "title": "Streak reminder failures — reasons",
   "description": "Percobaan OneSignal yang gagal pada rentang dashboard, dikelompokkan menurut alasan yang aman untuk metrik.",
   "type": "bargauge",
   "gridPos": {
    "x": 12,
    "y": 47,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason_code) (max without(instance, job) (increase(surau_notification_delivery_attempts_total{notification_type=\"streak_reminder\",result=\"failed\"}[$__range])))",
     "instant": true,
     "range": false,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{reason_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   }
  },
  {
   "id": 18,
   "title": "LLM cost today",
   "description": "Biaya 24 jam terakhir dalam USD; ledger sumber tetap integer nano-USD.",
   "type": "stat",
   "gridPos": {"x": 0, "y": 54, "w": 6, "h": 7},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "targets": [{
    "refId": "A",
    "expr": "sum(increase(surau_inference_cost_nano_usd_total[24h])) / 1e9",
    "instant": true,
    "range": false,
    "datasource": {"type": "prometheus", "uid": "prometheus"}
   }],
   "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 6, "min": 0}, "overrides": []},
   "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "textMode": "auto"}
  },
  {
   "id": 19,
   "title": "LLM daily breakdown — task / provider",
   "description": "Biaya per task dan provider pada rentang dashboard.",
   "type": "timeseries",
   "gridPos": {"x": 6, "y": 54, "w": 18, "h": 7},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "targets": [{
    "refId": "A",
    "expr": "sum by (task, provider) (increase(surau_inference_cost_nano_usd_total[$__rate_interval])) / 1e9",
    "legendFormat": "{{task}} · {{provider}}",
    "datasource": {"type": "prometheus", "uid": "prometheus"}
   }],
   "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 6, "min": 0}, "overrides": []}
  },
  {
   "id": 20,
   "title": "LLM tokens — input / cached / output",
   "description": "Token menurut task, provider, arah, dan sumber provider/estimasi.",
   "type": "timeseries",
   "gridPos": {"x": 0, "y": 61, "w": 12, "h": 8},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "targets": [{
    "refId": "A",
    "expr": "sum by (task, provider, direction, source) (increase(surau_inference_tokens_total[$__rate_interval]))",
    "legendFormat": "{{task}} · {{provider}} · {{direction}} · {{source}}",
    "datasource": {"type": "prometheus", "uid": "prometheus"}
   }],
   "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []}
  },
  {
   "id": 21,
   "title": "LLM budget guard",
   "description": "Progress baseline serta rasio cap harian/bulanan. Alarm Telegram aktif hanya untuk mode enforce.",
   "type": "bargauge",
   "gridPos": {"x": 12, "y": 61, "w": 12, "h": 8},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "targets": [
    {
     "refId": "A",
     "expr": "surau_inference_budget_baseline_progress_ratio",
     "instant": true,
     "range": false,
     "legendFormat": "baseline progress",
     "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
     "refId": "B",
     "expr": "surau_inference_budget_usage_ratio{window=\"daily\",mode=\"enforce\"}",
     "instant": true,
     "range": false,
     "legendFormat": "daily cap",
     "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
     "refId": "C",
     "expr": "surau_inference_budget_usage_ratio{window=\"monthly\",mode=\"enforce\"}",
     "instant": true,
     "range": false,
     "legendFormat": "monthly cap",
     "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 1}]}
    },
    "overrides": []
   },
   "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true}
  },
  {
   "id": 22,
   "title": "LLM exact vs estimated cost / cache hit-rate",
   "description": "Biaya berdasarkan token provider versus estimasi konservatif, plus efektivitas cache aman.",
   "type": "timeseries",
   "gridPos": {"x": 0, "y": 69, "w": 12, "h": 8},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (usage_source) (increase(surau_inference_cost_by_usage_source_nano_usd_total[$__rate_interval])) / 1e9",
     "legendFormat": "cost · {{usage_source}}",
     "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
     "refId": "B",
     "expr": "sum(rate(surau_inference_cache_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(surau_inference_cache_total[5m])), 1e-9)",
     "legendFormat": "cache hit-rate",
     "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
   ],
   "fieldConfig": {"defaults": {"min": 0}, "overrides": []}
  },
  {
   "id": 23,
   "title": "LLM failover / budget rejection",
   "description": "Jumlah failover dan penolakan pagar biaya pada rentang dashboard.",
   "type": "stat",
   "gridPos": {"x": 12, "y": 69, "w": 12, "h": 8},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(surau_inference_failovers_total[$__range])) or vector(0)",
     "instant": true,
     "range": false,
     "legendFormat": "failover",
     "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
     "refId": "B",
     "expr": "sum(increase(surau_inference_budget_rejections_total[$__range])) or vector(0)",
     "instant": true,
     "range": false,
     "legendFormat": "budget rejected",
     "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
     "refId": "C",
     "expr": "max(surau_inference_budget_config_alert{kind=\"zero_baseline\"}) or vector(0)",
     "instant": true,
     "range": false,
     "legendFormat": "baseline config alert",
     "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
   ],
   "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0}, "overrides": []},
   "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "textMode": "auto"}
  }
 ],
 "tags": [
  "surau",
  "f1-b"
 ]
}
