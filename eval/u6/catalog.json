  "seeds": [
    {
      "id": "u1-id-ar-anchor-pairs",
      "category": "cross-lingual-id-ar",
      "owner": "U-1",
      "depends_on": ["U-1"],
      "minimum_scenarios": 8,
      "required_assertions": [
        "Indonesian and Arabic questions resolve to the same expected Anchor",
        "cross-corpus retrieval remains license-eligible",
        "candidate is compared against tree on the same catalog snapshot"
      ],
      "examples": [
        {
          "id": "u1-seed-quran-2-183",
          "questions": {
            "id": "Mengapa puasa menjadi sebab ketakwaan menurut tafsir QS 2:183?",
            "ar": "لماذا كان الصيام من أسباب التقوى في تفسير الآية ٢:١٨٣؟"
          },
          "expected_anchor": "kitab/42/h/104/u/4"
        },
        {
          "id": "u1-seed-fawakih-author",
          "questions": {
            "id": "Siapa penulis الفواكه العذاب?",
            "ar": "من مؤلف رسالة الفواكه العذاب؟"
          },
          "expected_anchor": "kitab/1/h/2/u/5"
        }
      ],
      "notes": "Inactive until the U-1 candidate index and embedding path exist."
    },
